RewriteEngine On

# Empêcher l'accès direct aux dossiers sensibles
RewriteRule ^(app|storage|config)/ - [F,L]

# Si le fichier existe, on l'affiche
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Toutes les autres requêtes passent par index.php
RewriteRule ^ index.php [QSA,L]
